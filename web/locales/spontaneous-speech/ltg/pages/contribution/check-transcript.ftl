## Check Transcriptions page

# actionType will be Click (for desktop devices) or Tap (for mobile devices)
transcription-page-instruction = { $actionType } <playIcon></playIcon> Klausotēs audio īrokstu i puorbaudit transkripceju. Voi tei atbylst? Ka nā, redigejit tū, lai tei piļneibā atbylstu.
# Header of the textbox that contains a transcription of an audio
check-editbox-header = Puorbaude
# Message which appears when there are no more resources on this page
no-transcriptions-continue-skipped-message = Niule itamā volūdā puorbaudeišonai nav daīmama nivīna transkripceja. Ka esit kaidu izlaids, varit turpynuot dorbu ar izlaistū saturu voi ari īt iz audio puorraksteišonys sadaļu.
vote-transcript-success = Puorbaude saglobuota
vote-transcript-error = Saglobojūt puorbaudi, nūtykuse klaida
transcript-edited-success = Lobuojums saglobuots
transcript-edited-error = Saglobojūt lobuojumu, nūtykuse klaida
error-fetching-transcriptions = Īluodejūt transkripcejis, nūtykuse klaida. Lyudzu raugit vēļreiz nadaudz vāluok.
transcript-skipped-success = Puorbaude izlaista
transcript-skipped-error = Izlaižūt puorbaudi, nūtykuse klaida
# For the button on the Check Transcriptions page to assert that a transcription is correct
correct = Ir pareizi
# For the button on the Check Transcriptions page to indicate that a user has finished editing a transcription
done = Gotovs
# For the button on the Check Transcriptions page to edit a transcription
edit = Redigēt
