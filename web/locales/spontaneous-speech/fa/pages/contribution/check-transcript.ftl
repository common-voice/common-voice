## Check Transcriptions page

# actionType will be Click (for desktop devices) or Tap (for mobile devices)
transcription-page-instruction = { $actionType } <playIcon></playIcon> به صدای ضبط شده، گوش دهید و رونویسی را بررسی کنید. با صدا مطابقت دارد؟ اگر نه، آن را ویرایش کنید تا کاملاً مطابقت داشته باشد.
# Header of the textbox that contains a transcription of an audio
check-editbox-header = بررسی
# Message which appears when there are no more resources on this page
no-transcriptions-continue-skipped-message = در حال حاضر رونویسی‌ای برای بررسی در این زبان وجود ندارد. اگر از مواردی رد شده‌اید، می‌توانید با محتوای ردشده ادامه دهید یا به رونویسی صدا بروید و بعداً دوباره امتحان کنید.
vote-transcript-success = رأی به رونویسی با موفقیت ثبت شد
vote-transcript-error = هنگام رأی دادن به رونویسی خطایی رخ داد
transcript-edited-success = رونویسی با موفقیت ویرایش شد
transcript-edited-error = هنگام ویرایش رونویسی خطایی رخ داد
error-fetching-transcriptions = هنگام دریافت رونویسی‌ها مشکلی پیش آمد. لطفاً بعداً دوباره امتحان کنید.
transcript-skipped-success = از رونویسی با موفقیت رد شدید
transcript-skipped-error = هنگام رد شدن از رونویسی خطایی رخ داد
# For the button on the Check Transcriptions page to assert that a transcription is correct
correct = درست است
# For the button on the Check Transcriptions page to indicate that a user has finished editing a transcription
done = انجام شد
# For the button on the Check Transcriptions page to edit a transcription
edit = ویرایش
