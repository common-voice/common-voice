## Prompts page

record-player-header = اپݨا جواب ریکارڈ کرو
mic-access-error = مائیکروفون دی رسائی دی تہاݙی اجازت ضروری ہے۔
# actionType will be Click (for desktop devices) or Tap (for mobile devices)
prompt-page-instruction = { $actionType } <micIcon></micIcon> تے جتنا قدرتی ہو سڳے جواب ݙیو
# Message which appears when there are no more resources on this page
no-prompts-continue-skipped-message = ایں زبان کیتے ہور کوئی سوال نہیں ہن۔ اگر تساں کوئی چھوڑ ݙتے ہن، تاں تساں چھوڑے ڳئے مواد نال جاری رکھ سڳدے ہو یا آڈیو ٹرانسکرائب کرݨ تے ونڄو تے بعد وچ دوبارہ کوشش کرو۔
error-skipping = ایں پرامپٹ نوں چھوڑیندے ویلے خرابی تھئی
error-recording = ریکارڈنگ کریندے ویلے خرابی تھئی
error-recording-too-short = ریکارڈنگ بہوں چھوٹی ہے۔ گھٹ توں گھٹ مدت { $minDurationSeconds } سیکنڈ ہے۔
error-recording-too-long = ریکارڈنگ بہوں لمبی ہے۔ ودھ توں ودھ مدت { $maxDurationMinutes } منٹ ہے۔
error-fetching-prompts = پرامپٹس گھنݨ وچ کجھ غلط تھی ڳیا۔ مہربانی کرکے بعد وچ دوبارہ کوشش کرو۔
error-uploading-response = تہاݙا جواب اپلوڈ کریندے ویلے خرابی تھئی
error-empty-audio = ریکارڈنگ ناکام تھئی۔ آڈیو فائل خالی لڳدی ہے۔ مہربانی کرکے دوبارہ کوشش کرو۔
error-platform-webview = ایں محدود براؤزر وچ ریکارڈنگ دی سپورٹ نہ ہو سڳدی ہے۔ مہربانی کرکے مکمل براؤزر ایپ استعمال کرو۔
error-recording-too-short-seconds = ریکارڈنگ بہوں چھوٹی ہے۔ گھٹ توں گھٹ مدت { $minDurationSeconds } سیکنڈ ہے۔
error-recording-too-long-minutes = ریکارڈنگ بہوں لمبی ہے۔ ودھ توں ودھ مدت { $maxDurationMinutes } منٹ ہے۔
cannot-play-audio = آڈیو چلاوݨ توں قاصر۔ مہربانی کرکے دوبارہ کوشش کرو۔
prompt-submitted-success = جواب کامیابی نال جمع کر ݙتا ڳیا
prompt-response-deleted-success = جواب کامیابی نال حذف کر ݙتا ڳیا
# For the button to delete a response to a prompt
delete = مٹاؤ
# For the disabled button on a prompt that indicates a prompt is already submitted
submitted = جمع تھئے ہوئے
# For the button on the Respond to prompts page which can be used to submit all responses at once
submit-all-button = تمام جمع کراؤ

