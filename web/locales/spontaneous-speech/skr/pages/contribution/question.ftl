## Question Page

question-page-instruction = لوکاں دے جواب ݙیوݨ کیتے { $currentLocale } وچ ہک سوال <icon></icon> شامل کرو
add-question-textarea-placeholder = مثال طور، 'تساں ٹیکنالوجی نوں کیہڑے کم کیتے ورتݨا چاہندے ہو؟'
add-questions-terms-checkbox = * میں تصدیق کریندا ہاں جو ایہ سوال <publicDomainLink>عوامی ڈومین</publicDomainLink> ہے تے میکوں ایں نوں اپلوڈ کرݨ دی اجازت ہے۔
question-dataset-language = ڈیٹاسیٹ: { $datasetLanguage }
add-question-success-toast-message =
    { $totalQuestions ->
        [one] { $uploadedQuestions } از 1 سوال جمع کیتا ڳیا
       *[other] { $uploadedQuestions } از { $totalQuestions } سوال جمع کیتے ڳئے
    }
add-question-error-message = اپلوڈ ناکام تھیا، مہربانی کرکے دوبارہ کوشش کرو۔
add-question-too-many-questions-error = 25 سوال توں ودھ ڳئے۔ سوالاں دی تعداد گھٹاؤ تے دوبارہ کوشش کرو۔
partial-questions-upload-message =
    { $totalQuestions ->
        [one] { $uploadedQuestions } از 1 سوال جمع کیتا ڳیا۔ سوال شامل کرݨ دے بارے وچ ہور جانݨ کیتے ساݙے <guidelinesLink>رہنمائی</guidelinesLink> صفحے ݙیکھو
       *[other] { $uploadedQuestions } از { $totalQuestions } سوال جمع کیتے ڳئے۔ سوال شامل کرݨ دے بارے وچ ہور جانݨ کیتے ساݙے <guidelinesLink>رہنمائی</guidelinesLink> صفحے ݙیکھو
    }
# Guidelines
add-question-guidelines-title = میں کیہڑے سوال شامل کر سڳدا ہاں؟
do-section-title = کرو
do-section-guideline-1 = صحیح ہجے تے گرامر استعمال کرو
do-section-guideline-2 = ایہجے سادہ سوال چݨو جیہڑے ثقافت یا سیاق و سباق توں قطع نظر ہر کہیں کیتے سمجھݨ وچ آسان ہوون
do-section-guideline-3 = یقینی بݨاؤ جو انہاں دا جواب صرف ہک دو جملے وچ ݙتا ونڄ سڳے
do-not-section-title = نہ کرو
do-not-section-guideline-1 = ذاتی شناختی معلومات (جیویں ناں یا مالی معلومات) منگو
do-not-section-guideline-2 = متعصبانہ یا جارحانہ جذبات دا اظہار کرو یا منگو
do-not-section-guideline-3 = حساس سوال پچھو
# Code switching Guidelines
cs-do-section-guideline-1 = دو لسانی سوال یا سیاق استعمال کرو
cs-do-section-guideline-2 = غیر رسمی منظرنامے، حالات، یا دوبارہ اداکاری دی کھوج کرو
cs-do-not-section-guideline-1 = ذاتی شناختی معلومات (جیویں ناں یا مالی معلومات) یا جارحانہ جذبات منگو
cs-do-not-section-guideline-2 = کوڈ سوئچنگ منگو یا ترجمے دی درخواست کرو
cs-do-not-section-guideline-3 = بہوں رسمی زبان استعمال کرو
