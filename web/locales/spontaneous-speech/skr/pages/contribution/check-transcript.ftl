## Check Transcriptions page

# actionType will be Click (for desktop devices) or Tap (for mobile devices)
transcription-page-instruction = { $actionType } <playIcon></playIcon> آڈیو کلپ سݨو، تے نقل دی جانچ کرو۔ کیا ایہہ ملدی ہے؟ جے نہیں، تاں اونکوں بالکل ملاوݨ کیتے ایڈٹ کرو۔
# Header of the textbox that contains a transcription of an audio
check-editbox-header = پڑٹال کرو
# Message which appears when there are no more resources on this page
no-transcriptions-continue-skipped-message = فی الحال اس زبان کیتے جانچݨ کیتے کوئی نقل موجود نہیں۔ جے تساں کوئی چھوڑیا ہویا ہے، تاں تساں چھوڑے ہوئے مواد نال جاری رکھ سڳدے ہو یا آڈیو دی نقل کرݨ تے ونڄ کے بعد وچ دوبارہ کوشش کرو۔
vote-transcript-success = نقل تے کامیابی نال ووٹ ݙتا ڳیا
vote-transcript-error = نقل تے ووٹ ݙیندے ویلے کوئی خرابی تھئی
transcript-edited-success = نقل کامیابی نال ایڈٹ کیتی ڳئی
transcript-edited-error = نقل ایڈٹ کریندے ویلے کوئی خرابی تھئی
error-fetching-transcriptions = نقلاں حاصل کریندے ویلے کجھ غلط تھیا۔ براہ کرم بعد وچ دوبارہ کوشش کرو۔
transcript-skipped-success = نقل کامیابی نال چھوڑی ڳئی
transcript-skipped-error = نقل چھوڑدے ویلے کوئی خرابی تھئی
# For the button on the Check Transcriptions page to assert that a transcription is correct
correct = ٹھیک
# For the button on the Check Transcriptions page to indicate that a user has finished editing a transcription
done = تھی ڳیا
# For the button on the Check Transcriptions page to edit a transcription
edit = تبدیلی کرو
