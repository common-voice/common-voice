## Error pages

banner-error-slow-1 = افسوس، کامن وائس مٹھا چلدا پئے۔ تہاݙا دلچسپی دا تھورا۔
banner-error-slow-2 = اساں ٻہوںساری ٹریفک وصول کریندے پئے ہیں تے رولیاں بارے تحقیقاں کریندے پئے ہیں۔
banner-error-slow-link = سٹیٹس ورقہ
error-something-went-wrong = افسوس، کجھ خرابی تھی ڳئی
error-clip-upload = ایں کلپ دا اپ لوڈ کرݨ ناکام تھیندا رہندے۔ کوشش کریندے رہوں؟
error-clip-upload-server = ایں کلپ دا سرور تے اپ لوڈ ناکام تھیندا رہندے۔ ورقہ ولدا لوڈ کرو یا بعد وچ ولدا کوشش کرو۔
error-clip-upload-too-large = تہاݙی ریکارڈنگ فائل اپ لوڈ کرݨ کیتے ٻہوں وݙی ہے۔ مہربانی کرکے چھوٹا کلپ ریکارڈ کرݨ دی کوشش کرو۔
error-clip-upload-server-error = تہاݙے کلپ دی پروسیسنگ وچ سرور دی خرابی۔ مہربانی کرکے صفحہ دوبارہ لوڈ کرو یا بعد وچ دوبارہ کوشش کرو۔
error-title-404 = اساں تہاݙے کیتے او ورقہ کائنی لبھ سڳے
error-content-404 =
    تھی سڳدا ہے جو ساݙا  <homepageLink> ہوم پیج </homepageLink> مدد کرے؟ سوال پچھݨ کیتے، براہ مہربانی <matrixLink>میٹرکس کمیونٹی چیٹ </matrixLink> وِچ شامل تھیوو، 
    <githubLink>GitHub</githubLink> دے ذریعے سائٹ دے مسائل دی نگرانی کرو یا <discourseLink> ساݙے ڈسکورس فورماں </discourseLink> تے ونڄو۔
error-title-429-no-time = تساں ٻہوں تیز ویندے پئے ہو۔ مہربانی کرکے ہولی تھیوو تے تھوڑی دیر بعد دوبارہ کوشش کرو۔
error-title-429-with-time =
    { $retryAfter ->
        [one] تساں ٻہوں تیز ویندے پئے ہو۔ مہربانی کرکے { $retryAfter } سیکنڈ وچ دوبارہ کوشش کرو۔
       *[other] تساں ٻہوں تیز ویندے پئے ہو۔ مہربانی کرکے { $retryAfter } سیکنڈ وچ دوبارہ کوشش کرو۔
    }
error-title-500 = معذرت، کجھ غلط تھی ڳیا
error-content-500 = ہک غیر متوقع خرابی تھی ڳئی ہے۔ مہربانی کرکے بعد وچ دوبارہ کوشش کرو۔ مدد کیتے، مہربانی کرکے <matrixLink>Matrix community chat</matrixLink> وچ شامل تھیوو، <githubLink>GitHub</githubLink> دے ذریعے سائٹ دے مسئلیاں دی نگرانی کرو یا <discourseLink>ساݙے Discourse forums</discourseLink> تے ونڄو۔
error-title-502 = کنکشن منقطع تھی ڳیا
error-content-502 = تساں ایس ویلے ساݙے سرورز نال مستحکم کنکشن قائم نہیں کر سڳدے۔ مہربانی کرکے بعد وچ دوبارہ کوشش کرو۔ مدد کیتے، مہربانی کرکے <matrixLink>Matrix community chat</matrixLink> وچ شامل تھیوو، <githubLink>GitHub</githubLink> دے ذریعے سائٹ دے مسئلیاں دی نگرانی کرو یا <discourseLink>ساݙے Discourse forums</discourseLink> تے ونڄو۔
error-title-503 = ساکوں ابڑغت ڈاؤن ٹائم دا سامھݨا ہے۔
error-content-503 = سائٹ دا ٹھَک پھَک بیک اپ گھدا ویسے۔ نویاں نکور معلومات کیتے، براہ مہربانی <matrixLink> میٹرکس کمیونٹی چیٹ </matrixLink> وِچ شامل تھیوو یا <githubLink>GitHub</githubLink> یا <discourseLink> اساݙے ڈسکورس فورمز </discourseLink> کوں سائٹ دے تجربے دے مسائل کون جمع کراوݨ تے مانیٹر کرݨ کیتے ݙیکھو۔
error-title-504 = درخواست دا وقت ختم
error-content-504 = درخواست مکمل تھیوݨ وچ ٻہوں وقت لڳ ڳیا۔ ایہ عام طور تے عارضی ہے۔ مہربانی کرکے دوبارہ کوشش کرو۔ مدد کیتے، مہربانی کرکے <matrixLink>Matrix community chat</matrixLink> وچ شامل تھیوو، <githubLink>GitHub</githubLink> دے ذریعے سائٹ دے مسئلیاں دی نگرانی کرو یا <discourseLink>ساݙے Discourse forums</discourseLink> تے ونڄو۔
error-code = خرابی { $code }
# Warning message shown when none of the clips could be uploaded
error-duplicate-clips-all =
    { $total ->
        [one] اساں تہاݙا کلپ اپ لوڈ نہیں کر سڳے۔ ایہ پہلے ہی اپ لوڈ تھی چکیا ہے۔ آؤ اڳلے بیچ نال جاری رکھوں!
       *[other] اساں { $total } کلپ اپ لوڈ نہیں کر سڳے۔ ایہ پہلے ہی اپ لوڈ تھی چکے ہن۔ آؤ اڳلے بیچ نال جاری رکھوں!
    }
# Warning message shown when only some of the clips could be uploaded (uploaded count will be <5)
error-duplicate-clips-some = اساں تہاݙے { $uploaded } کلپ اپ لوڈ کیتے — باقی پہلے ہی اپ لوڈ تھی چکے ہن۔ آؤ اڳلے بیچ نال جاری رکھوں!
