code-switching-adding-question-criteria-3 = نقصان دہ یا توہین آمیز زبان نہ ورتے یا نہ منگواوے
code-switching-adding-question-note = تساں مختلف سیاق و سباق تے شعبے شامل کرݨ تے وی غور کر سڳدے ہو۔
# What types of questions to add
code-switching-types-subheader = کیہڑے قسم دے سوال شامل کرو؟
code-switching-use-bilingual-prompts-header = ٻہ لسانی پرامپٹس ورتو
code-switching-use-bilingual-prompts-explanation = اپݨے سوال وچ ٻہ زباناں شامل کرݨ آلے دو لسانی پرامپٹس ورتو: مثال:
code-switching-use-bilingual-prompts-explanation-example = "تہاݙی امی نے تہاکوں کیا آکھیا when you got home that day?"
code-switching-ask-bilingual-contexts-header = دو لسانی سیاق و سباق دے بارے وچ پچھو
code-switching-ask-bilingual-contexts-explanation = او حالات ورتو جتھاں ٻہ زباناں عام طور تے ورتیاں ویندن (جیویں گھر، اسکول، برادری دے پروگرام)۔ مثال:
code-switching-ask-bilingual-contexts-explanation-example = "جݙاں تساں اپݨے کزناں نال ڳالھ کریندے ہوو، کیا تساں ہسپانوی تے انگریزی مکس کریندے ہوو؟"
code-switching-focus-emotional-header = جذباتی یا اہم موقعیاں تے توجہ ݙیو
code-switching-focus-emotional-explanation = لوک اکثر جذبات یا جلدی دا اظہار کریندے ویلے کوڈ سوئچ کریندن۔ مثال:
code-switching-focus-emotional-explanation-example = "مینوں ݙسو تہاݙے والدین نے کیا آکھیا جݙاں تساں انہاں کوں اپݨی وݙی خبر ݙتی - بالکل اونویں جیویں انہاں آکھیا ہا۔"
code-switching-direct-quotes-header = براہ راست اقتباسات یا دوبارہ اداکاری کیتے پچھو
code-switching-direct-quotes-explanation = شرکاء دی حوصلہ افزائی کرو کہ او اونویں دہراوݨ جیویں اصل وچ آکھیا ڳیا ہا۔ مثال:
code-switching-direct-quotes-explanation-example = "تہاݙے ٹھیک ٹھیک لفظ کیا ہن جݙاں تہاکوں پتہ لڳا؟"
code-switching-cultural-topics-header = ثقافتی طور تے مخصوص موضوعات چݨو
code-switching-cultural-topics-explanation = کھاݨا، روایات، تہوار تے خاندانی روابط اکثر کوڈ سوئچنگ دی دعوت ݙیندن۔
code-switching-cultural-topics-explanation-example = تساں Día de los Muertos کوں اوں بندے کوں کیویں ݙسیندے ہوو جیہڑا صرف انگریزی ٻولیندا ہے؟
code-switching-informal-scenarios-header = غیر رسمی منظرنامے تلاش کرو
code-switching-informal-scenarios-explanation = دوستاں نال ڳالھ بات یا ٹیکسٹنگ وچ اکثر ودھ قدرتی سوئچنگ ہوندی ہے۔ مثال:
code-switching-informal-scenarios-explanation-example = "تہاݙے دوست ہمیشہ کیہڑا مذاق کریندن - تے او اونکوں کیویں آہدن؟"
# What to Avoid
code-switching-avoid-subheader = کنھاں توں پرہیز کرو
code-switching-avoid-intro = ایہو جیہے سوال جیہڑے:
code-switching-avoid-1 = ذاتی شناخت دی معلومات طلب کرو
code-switching-avoid-2 = نفرت انگیز گفتگو یا تعصب آمیز یا توہین آمیز جذبات طلب کرو
code-switching-avoid-3 = کسی کوں حساس تے ممکنہ طور تے تکلیف دہ جواب ݙیوݨ تے مجبور کرو
code-switching-dont-header = نہ کرو
code-switching-dont-1 = بہت زیادہ رسمی زبان نہ ورتو
# Reviewing a Question
code-switching-review-subheader = سوال دا جائزہ گھنݨا
code-switching-review-intro = یقینی بݨاؤ کہ سوال معیار تے پورا اتردا ہے:
code-switching-review-criterion-1 = سمجھݨ تے جواب ݙیوݨ وچ آسان ہووے
code-switching-review-criterion-2 = عام طور تے متعلقہ ہووے
code-switching-review-criterion-3 = نقصان دہ یا توہین آمیز زبان نہ ورتے یا نہ منگواوے
code-switching-review-does-not-header = تے <bold>شامل نہیں</bold> ہے:
code-switching-review-offensive-content = <bold>توہین آمیز مواد یا حساس معلومات</bold>
code-switching-answer-header = توہین آمیز مواد یا حساس معلومات
code-switching-review-no-1 = او سوال جیہڑے ذاتی شناخت دی معلومات منگوا سڳن
code-switching-review-no-2 = او سوال جیہڑے نفرت انگیز گفتگو یا تعصب آمیز یا توہین آمیز جذبات منگوا سڳن
code-switching-review-no-3 = او سوال جیہڑے کسی کوں حساس تے ممکنہ طور تے تکلیف دہ جواب شیئر کرݨ تے مجبور کر سڳن
# Answering a Question
code-switching-answer-subheader = سوال دا جواب ݙیوݨا
code-switching-answer-intro = سوال دا جواب ݙیندے ویلے، مقصد قدرتی طور تے جواب ݙیوݨا ہے - بالکل ایویں جیویں تساں اصلی زندگی دی گفتگو وچ کریندے ہو۔ اساں ایہہ ڄاݨݨا چاہندے ہیں کہ روزمرہ دی ڳالھ وچ زباناں کیویں رلدیاں ہن۔
code-switching-answer-bullet-1 = اصلی زندگی دے لمحیاں یا حالات دے بارے وچ سوچو: لطیفے، بحث، روایات
code-switching-answer-bullet-2 = سوچو کہ تساں کہیں دوست کوں پیغام بھیجدے پئے ہو یا کہیں کوں قصہ سݨیندے پئے ہو
code-switching-answer-bullet-3 = ایہو جیہے الفاظ ورتو جیہڑے تساں واقعی ورتیندے ہو، بھانویں ادھار دے ہوون یا رلے ملے
code-switching-answer-bullet-4 = جواب ݙیوݨ دا کوئی “کامل” طریقہ نہیں ہے
code-switching-authentic-header = قدرتی تے مستند طور تے جواب ݙیو
code-switching-authentic-speak = <bold>ایویں ڳالھ کرو جیویں دوستاں یا ٹبر نال کریندے ہو۔</bold> جے تساں اصلی زندگی وچ زباناں رلیندے ہو، تاں ایتھے وی ایویں کرو۔ مثال:
code-switching-authentic-speak-example = “خیر I told her I couldn’t go, but she was like, ‘You better show up!’”
code-switching-use-both-languages = <bold>دونہیں زباناں ورتو جے ایویں تساں عام طور تے آکھدے ہو۔</bold> بھانویں ہک دو لفظ بدلݨا وی فائدہ مند ہے۔ مثال:
code-switching-use-both-languages-example = “She got really mad کیونکہ I didn’t call her back.”
code-switching-authentic-direct-quotes = <bold>براہ راست اقتباس یا مکالمہ شامل کرو۔</bold> بالکل اوہی آکھو جو کہیں نے آکھیا، صاف ستھرا یا رسمی ورژن نہیں۔ مثال:
code-switching-authentic-direct-quotes-example = “میݙی امی نے آکھیا، ‘توں سمجھدی ہیں ایہہ ہک کھیݙ ہے؟’ and I was like, ‘Okay chill!’”
code-switching-authentic-reflect = <bold>جذبات، شناخت تے ماحول کوں سامݨے رکھو۔</bold> زباناں دا ملاپ عام طور تے اوں ویلے ہوندا ہے جݙاں لوک جذبات، جلد بازی یا ثقافتی نظریات ظاہر کریندے ہن۔ سوالاں دے جواب وچ انہاں ول توجہ ݙیو۔
code-switching-authentic-full-context = <bold>مکمل جواب سیاق و سباق نال ݙیو۔</bold> جتنا ممکن ہووے تفصیل نال ݙیو، جتنی تفصیل ݙے سڳدے ہو ݙیو۔ اپݨے جواب وچ کوئی کہانی یا مثال شیئر کرو۔
# Don’t Overthink or Overedit
code-switching-answer-dont-subheader = زیادہ نہ سوچو یا زیادہ ترمیم نہ کرو
code-switching-answer-dont-correct-language = <bold>اپݨی زبان “درست” نہ کرو۔</bold> ایہہ کوئی امتحان نہیں ہے۔ “مناسب” انداز ایتھے اہم نہیں، قدرتی زبان اہم ہے۔
code-switching-answer-dont-avoid-switching = <bold>جے تساں عام طور تے زبان رلیندے ہو تاں رلاوݨ توں نہ بچو۔</bold> جملے دے وچکار، خیال دے وچکار، یا صرف ہک لفظ کیتے بدلݨ ٹھیک ہے۔
code-switching-answer-dont-formal-writing = <bold>ایویں نہ ڳالھ کرو جیویں رسمی طور تے لکھدے ہو۔</bold> رسمی، تعلیمی جواباں توں بچو۔ ڳالھ بات والی رکھو۔
code-switching-answer-dont-force-switch = <bold>جے قدرتی نہ ہووے تاں زبان بدلݨ تے زور نہ ݙیو۔</bold> صرف اوں ویلے زبان بدلو جے ایویں تساں قدرتی طور تے اوں صورت حال وچ ڳالھ کریندے ہو۔
code-switching-answer-dont-translate-repeat = <bold>سب کجھ ترجمہ یا دہراؤ نہ کرو۔</bold> صرف ہک واری آکھو، جیویں گفتگو وچ آندا ہے۔ تہاکوں ہر زبان وچ جواب دا ورژن نہیں آکھݨا پیندا۔
# Transcribing
code-switching-transcribe-subheader = نقل تیار کرݨا
code-switching-transcribe-intro = جداں کوڈ سوئچنگ آلے جواباں دی نقل تیار کرو، تاں ٻولݨ آلے دی زبان اویویں لکھو جیویں ٻولی ڳئی - بغیر درست کیتے، ترمیم کیتے یا سادہ کیتے۔ ایہہ زباناں وچکار ساریاں تبدیلیاں، غیر رسمی ڳالھ تے ملے جلے لفظاں کیتے ہے۔
code-switching-transcribe-do-1 = باریک تبدیلیاں پکڑݨ کیتے چھوٹے حصے کئی واری چلاؤ
code-switching-transcribe-do-2 = ہر جملے دے بعد رکو تاکہ تبدیلیاں یا رلے ملے لفظاں دی دوبارہ جانچ کر سڳو
# Capture Speech Exactly as Spoken
code-switching-capture-header = ڳالھ بالکل اویویں پکڑو جیویں ٻولی ڳئی
code-switching-capture-explanation = دونہیں زباناں اویویں نقل کرو جیویں ݙسدیاں / سݨدیاں ہن۔ زبان کوں “درست” نہ کرو یا صرف ہک زبان وچ نہ بدلو۔
# Include filler words and markers
code-switching-filler-header = بھرݨ آلے الفاظ تے نشانیاں شامل کرو
code-switching-filler-explanation = ایہو جیہے الفاظ جیویں “um،” “like،” “خیر،” “you know،” تے “تاں” معنی رکھدن۔ مثال: “So, um, I told her like, ‘خیر پتہ نہیں, maybe later.’”
# Use standard spelling for each language
code-switching-spelling-header = ہر زبان کیتے معیاری ہجے ورتو
code-switching-spelling-explanation = ہر زبان کیتے لفظاں دے ہجے درست کرݨ دی کوشش کرو، جے تک ٻولݨ آلا انہاں کوں واضح طور تے غیر معیاری طریقے نال نہ ٻولے۔
# Don’t Clean Up or Simplify the Language
code-switching-cleanup-header = زبان کوں صاف ستھرا نہ کرو یا سادہ نہ کرو
code-switching-cleanup-1 = ترجمہ یا خلاصہ نہ کرو - اوہی لکھو جو ٻولݨ آلے نے آکھیا، اوہ نہیں جو اوندا مطلب ہئی۔
code-switching-cleanup-2 = “درست” گرامر یا تلفظ - ٻولݨ آلے دے قدرتی ورتاوے کوں رکھو۔
code-switching-cleanup-3 = او تبدیلیاں نہ چھوڑو جیہڑیاں معمولی یا چھوٹیاں لڳن - ادھار گھدے ہوئے لفظ وی اہم ہن۔
code-switching-cleanup-4 = ایہو جیہی علامتاں نہ لاؤ جیہڑیاں مطلب بدل سڳن - روانی قدرتی رکھو۔
code-switching-cleanup-5 = ایہہ نہ سمجھو کہ تساں ہر لفظ دی زبان ڄاݨدے ہو - ورتاوے دی بنیاد تے ٹیگ لاؤ۔
# Tagging
code-switching-tagging-subheader = ٹیگنگ
code-switching-tagging-error-intro = جے نقل وچ کوئی غلطی ہووے، تاں براہ کرم رپورٹ فنکشن ورت کے اونکوں نشان زد کرو۔ ممکنہ غلطیاں وچ شامل ہن:
code-switching-tagging-error-1 = غلط علامتاں یا وݙے چھوٹے اکھر
code-switching-tagging-error-2 = ٹائپو
code-switching-tagging-error-3 = غلط املا وچ لکھے ہوئے لفظ
# Using Correct Orthography for Each Language
code-switching-orthography-header = ہر زبان کیتے درست املا ورتݨا
code-switching-orthography-explanation = ہر لفظ اوں زبان دے ہجے مطابق لکھو جیہڑی توں ہے۔ مثال طور تے:
code-switching-orthography-explanation-example-1 = جے لفظ “kitchen” ہسپانوی وانگوں ٻولیا ہویا لڳے، تاں اونکوں انگریزی وانگوں لکھݨا چاہیدا ہے، “quichen” وانگوں نہیں۔
code-switching-orthography-explanation-example-2 = جے لفظ quinceaños انگریزی وانگوں ٻولیا ڳیا ہووے، تاں اونکوں ñ نال لکھو۔
# Use Pronunciation to Help Determine the Language
code-switching-pronunciation-header = زبان دا تعین کرݨ کیتے تلفظ ورتو
code-switching-pronunciation-explanation = کجھ لفظ دونہیں زباناں وچ ہکو جیہے لڳ سڳدن پر مختلف طریقے نال ٻولے ونڄ سڳدن۔ صحیح ٹیگ لاوݨ کیتے تلفظ سݨو۔ مثال طور تے: cable, taco, actor, detective۔
code-switching-pronunciation-explanation-example-1 = انگریزی: /ˈkeɪ.bəl/
code-switching-pronunciation-explanation-example-2 = ہسپانوی: /ˈkable/
# Tagging in a Single Token
code-switching-single-token-header = ہک ٹوکن وچ ٹیگنگ
code-switching-single-token-explanation = ہک خلا نال انج ٹوکن وچ ہک توں ودھ ٹیگ شدہ حصے ہوݨے چاہیدن۔
# Tag Punctuation Based on Nearby Language
code-switching-punctuation-tagging-header = قریبی زبان دی بنیاد تے علامتاں کوں ٹیگ کرو
code-switching-punctuation-tagging-explanation = کھبے پاسے قریب ترین زبان دے حصے دی بنیاد تے علامتاں کوں ٹیگ کرو۔ مثالاں:
# text wrapped in purple and blue will be shown with a purple and blue background in the UI respectively
code-switching-punctuation-tagging-explanation-example-1 = <purple>and the one time that</purple> Maria <blue>screamed at me was</blue> <purple>کیونکہ</purple> <blue>she was trying to to</blue> <purple>printear</purple> <blue>order.</blue> (BangorTalk)
code-switching-punctuation-tagging-explanation-example-2 = <purple>but</purple> <blue>توں انہاں کوں لال، کالا، نیلا خرید سڳدی ہیں</blue> <purple>whatever.</purple>
# Be Careful with Lookalikes
code-switching-lookalikes-header = ہم شکل لفظاں توں ہوشیار رہو
code-switching-lookalikes-explanation = کجھ لفظ ہک زبان وانگوں لڳ سڳدن پر ٻئی زبان وچ ورتے ویندن۔ مطلب تے ورتاوے دی بنیاد تے ٹیگ کرو، شکل تے نہیں۔ مثالاں:
code-switching-lookalikes-explanation-example-1 = “Footing” ہسپانوی وچ دوڑݨ دے معنی وچ ورتیا ڳیا > ہسپانوی دے طور تے ٹیگ کرو
code-switching-lookalikes-explanation-example-2 = “No problemo” انگریزی وچ ورتیا ڳیا > انگریزی دے طور تے ٹیگ کرو
# When Not to Tag Words
code-switching-not-tag-header = لفظاں کوں ٹیگ نہ کرݨ ویلے
code-switching-not-tag-explanation = کجھ لفظاں تے <bold>ٹیگ نہیں لاوݨا چاہیدا</bold> زبان دے لیبل نال، چاہے اوہ ملے ہوئے یا ڈھالے ہوئے لڳن۔ ایتھے ݙسایا ڳیا ہے کہ کجھ مثالاں نال کیویں نبڑنا ہے:
code-switching-not-tag-proper-names = <bold>خاص ناں۔</bold> لوکاں، جاہاں تے تنظماں دے ناواں تے ٹیگ نہیں لاوݨا چاہیدا۔ مثالاں:
code-switching-not-tag-proper-names-example-1 = لوک: ماریا، جان
code-switching-not-tag-proper-names-example-2 = جاہیں: لاس اینجلس، فلوریڈا
code-switching-not-tag-proper-names-example-3 = برانڈز/تنظمات: ٹارگٹ، برگر کنگ
