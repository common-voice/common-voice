exceeds-small-batch-limit-error = نتونی بیش از ۱۰۰۰ جمله ارسال هاکنین
# $retryLimit represents the amount of time in minutes a user has to wait to retry an upload
rate-limit-toast-message-minutes = محدودیت جه یور بورده. دِباره { $retryLimit } دقه دیگه تلاش هاکنین.
# $retryLimit represents the amount of time in seconds a user has to wait to retry an upload
rate-limit-toast-message-seconds = محدودیت جه یور بورده. دِباره { $retryLimit } ثانیه دیگه تلاش هاکنین
# $retryLimit represents the amount of time in minutes a user has to wait to retry an upload
rate-limit-message-minutes = شما مجازِ محدوده ره یور بوردی و ننشنه دیگه هچّی راهی هاکنی. لطفاً { $retryLimit } دقه لس بی. فدا بووم!
# $retryLimit represents the amount of time in seconds a user has to wait to retry an upload
rate-limit-message-seconds = شما مجازِ محدوده ره یور بوردی و ننشنه دیگه هچّی راهی هاکنی. لطفاً { $retryLimit } ثانیه لس بی. فدا بووم!
# $uploadedSentences represents the number of sentences accepted from the small batch submission, $totalSentences represents the total number of sentences in the small batch submission
add-small-batch-success = { $totalSentences } جه ، { $uploadedSentences } تا جمله جمع بیّه
# $uploadedSentences represents the number of sentences accepted from the small batch submission, $totalSentences represents the total number of sentences in the small batch submission
small-batch-response-message = { $totalSentences } جه، { $uploadedSentences } تا جمله جمع بیّه. <downloadLink>اینجه</downloadLink> کلیک هاکنین تا رد بئی جملات ره دانلؤد هاکنین.
small-batch-sentences-rule-1 = راهنما ره هارشین که «چه جملاتی ره تومبه بی‌یلم؟»
small-batch-sentences-rule-2 = هر جمله ره اتا خط دله بی‌یلین
small-batch-sentences-rule-3 = جملات ره اینتر بزوئن جه یا ریترن بزوئن جه اتا خط دله سوا هاکنین
small-batch-sentences-rule-4 = تا ۱٫۰۰۰ جمله اضافه هاکنین
small-batch-sentences-rule-5 = گردِ جملات ونه همگانی دامنه دله دووشِن
small-batch-sentences-rule-6 = گردِ جملاتِ ارجاع ونه هئی واری بوئه
