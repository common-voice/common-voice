## Goals

days =
    { $count ->
        [one] မွူးနီꩻ
       *[other] မွူးနီꩻဖုံႏ
    }
recordings =
    { $count ->
        [one] ဒင်ႏမုဲင်တောင်ꩻအငေါဝ်း
       *[other] ဒင်ႏမုဲင်တောင်ꩻအငေါဝ်းဖုံႏ
    }
validations =
    { $count ->
        [one] အွဉ်ႏတိဉ်ႏလွေꩻ
       *[other] အွဉ်ႏတိဉ်ႏစွူ
    }
