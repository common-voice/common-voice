## REVIEW

sc-review-lang-not-selected = Ùn avete micca sceltu alcuna lingua. Ci vole à andà nantu à u vostru <profileLink>Prufilu</profileLink> per selezziunà una lingua.
sc-review-loading = Caricamentu di l'infrasate…
sc-review-select-language = Sceglite una lingua per verificà l'infrasate.
sc-review-form-button-reject = Ricusà
sc-review-form-button-approve = Cunvalidà
# Keyboard shortcut to use to approve a sentence (sc-review-form-button-approve)
sc-review-form-button-approve-shortcut = C
# Keyboard shortcut to use to reject a sentence (sc-review-form-button-reject)
sc-review-form-button-reject-shortcut = R
# Keyboard shortcut to use to skip a sentence (sc-review-form-button-skip)
sc-review-form-button-skip-shortcut = S
sc-review-form-button-submit =
    .submitText = Compie a cunvalidazione
# Variables:
#   $sentences (Number) - Number of sentences the user has reviewed in this session
sc-review-form-reviewed-message =
    { $sentences ->
        [0] Nisuna infrasata cunvalidata.
        [one] 1 infrasata cunvalidata. Vi ringraziemu !
       *[other] { $sentences } infrasate cunvalidate. Vi ringraziemu !
    }
